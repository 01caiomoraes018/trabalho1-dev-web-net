@model Paciente
@{
    ViewData["Title"] = "Detalhes do paciente";
}

<div class="form-card">
    <h1>Detalhes do paciente</h1>
    <dl class="details">
        <dt>Nome</dt><dd>@Model.Nome</dd>
        <dt>CPF</dt><dd>@Model.Cpf</dd>
        <dt>Telefone</dt><dd>@Model.Telefone</dd>
        <dt>Endereço</dt><dd>@Model.Endereco</dd>
        <dt>Data de Nascimento</dt><dd>@Model.DataNascimento.ToString("dd/MM/yyyy")</dd>
    </dl>
    <div class="form-actions">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
        <a class="btn" asp-action="Index">Voltar</a>
    </div>
</div>
