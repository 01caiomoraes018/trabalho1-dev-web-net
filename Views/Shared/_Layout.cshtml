<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Agendamento</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container nav-content">
                <a class="brand" asp-controller="Pacientes" asp-action="Index">Agendamento</a>
                <a asp-controller="Pacientes" asp-action="Index">Pacientes</a>
            </div>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">Trabalho 1 - Desenvolvimento Web com .NET</div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
